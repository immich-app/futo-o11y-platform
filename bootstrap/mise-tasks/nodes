#!/usr/bin/env bash
#MISE description="Apply the machine configs to $ENVIRONMENT's maintenance-mode nodes over their public IPs"

# Fresh nodes boot into maintenance mode and answer only on their public IPs
# until NetBird runs. Once configured, a node's firewall drops public apid
# traffic, so the connect times out and the node is skipped; //talos:apply
# changes configured nodes.
set -euo pipefail
: "${ENVIRONMENT:?set ENVIRONMENT=staging (or production) first}"

dir="$(mktemp -d)"
trap 'rm -rf "$dir"' EXIT
mise run //talos:render "$dir"
ovh="$(mise run //deployment/modules/ovh/account:output -- -json)"

for host in $(yq '.nodes[].host' "$TOPFCONFIG"); do
  ip="$(jq -er --arg host "$host" '[.controlplane_nodes.value, .worker_nodes.value][][] | select(.name == $host) | .public_ip' <<<"$ovh")"
  if [[ "$(curl -sk -o /dev/null -w '%{time_connect}' --connect-timeout 5 --max-time 10 "https://$ip:50000" || true)" == 0.000000 ]]; then
    echo "$host: skipped, apid on $ip does not answer (the node is configured or down)"
  elif out="$(talosctl apply-config --insecure --nodes "$ip" --file "$dir/$host.yaml" 2>&1)"; then
    echo "$host: config applied over $ip"
  elif [[ "$out" == *"certificate required"* ]]; then
    echo "$host: already configured, skipped"
  else
    echo "$host: $out" >&2
    exit 1
  fi
done
