#!/usr/bin/env bash
#MISE description="Wait until every $ENVIRONMENT node is registered and Ready"

# Waits for each node in topf.yaml by name, so a node that never joins (for
# example one that //bootstrap:nodes skipped) fails the wait and is named.
set -euo pipefail
: "${ENVIRONMENT:?set ENVIRONMENT=staging (or production) first}"

deadline=$((SECONDS + 1200))
until kubectl get --raw /readyz --request-timeout=10s >/dev/null 2>&1; do
  if ((SECONDS > deadline)); then
    echo "kube-apiserver did not answer within 20 minutes" >&2
    exit 1
  fi
  echo "waiting for kube-apiserver"
  sleep 5
done

for host in $(yq '.nodes[].host' "$TOPFCONFIG"); do
  kubectl wait --for=create "node/$host" --timeout=20m
done
kubectl wait nodes --all --for=condition=Ready --timeout=15m
