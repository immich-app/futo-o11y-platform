{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>immich-app/.github:renovate-config"],
  "semanticCommits": "enabled",
  "prHourlyLimit": 0,
  "flux": {
    "managerFilePatterns": ["/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/"]
  },
  "helm-values": {
    "managerFilePatterns": ["/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/"]
  },
  "kustomize": {
    "managerFilePatterns": ["/(^|/)kustomization\\.ya?ml(?:\\.j2)?$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "OCIRepository Tags and Digests",
      "managerFilePatterns": ["/(^|/)kubernetes/apps/.+\\.ya?ml$/"],
      "matchStrings": [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s*\\n\\s*tag:\\s*\"?(?<currentValue>[^\"\\s]+)\"?\\s*\\n\\s*digest:\\s*\"?(?<currentDigest>sha256:[a-f0-9]{64})\"?",
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s*\\n\\s*(?:-\\s+)?image: \\S+?:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    }
  ],
  "packageRules": [
    {
      "description": "Split base Kubernetes updates (and the staging Talos config, which tracks base) into their own PRs",
      "matchFileNames": ["kubernetes/apps/base/**", "talos/staging/**"],
      "additionalBranchPrefix": "base-",
      "semanticCommitScope": "base"
    },
    {
      "description": "Split development Kubernetes updates into their own PRs",
      "matchFileNames": ["kubernetes/apps/development/**"],
      "additionalBranchPrefix": "development-",
      "semanticCommitScope": "development"
    },
    {
      "description": "Split staging Kubernetes updates into their own PRs",
      "matchFileNames": ["kubernetes/apps/staging/**"],
      "additionalBranchPrefix": "staging-",
      "semanticCommitScope": "staging"
    },
    {
      "description": "Split production Kubernetes updates into their own PRs and gate behind manual approval in the dashboard",
      "matchFileNames": ["kubernetes/apps/production/**", "talos/production/**"],
      "additionalBranchPrefix": "production-",
      "semanticCommitScope": "production",
      "dependencyDashboardApproval": true
    },
    {
      "description": "Digests in env overlay patches are managed by the custom manager",
      "matchFileNames": [
        "kubernetes/apps/development/**",
        "kubernetes/apps/staging/**",
        "kubernetes/apps/production/**"
      ],
      "matchUpdateTypes": ["pinDigest"],
      "enabled": false
    },
    {
      "description": "o11y-manifests deliberately tracks the mutable main tag (re-pulled in-cluster on an interval); never pin its digest",
      "matchPackageNames": ["**/o11y-manifests"],
      "matchUpdateTypes": ["pinDigest"],
      "enabled": false
    },
    {
      "description": "Group mise tool updates into one PR. opentofu and terragrunt run every plan, so they stay separate to keep a plan diff attributable to one bump",
      "matchManagers": ["mise"],
      "matchDepNames": ["!opentofu", "!terragrunt"],
      "groupName": "mise tools"
    },
    {
      "description": "One Talos upgrade per environment: topf's talosVersion and the tuppr TalosUpgrade move together, with talosctl in staging's PR and the OVH image in production's",
      "matchDepNames": ["siderolabs/talos", "talosctl"],
      "groupName": "talos",
      "separateMinorPatch": true
    },
    {
      "description": "One Kubernetes upgrade per environment: topf's kubernetesVersion and the tuppr KubernetesUpgrade move together, with kubectl in staging's PR",
      "matchDepNames": ["ghcr.io/siderolabs/kubelet", "kubectl"],
      "groupName": "kubernetes",
      "separateMinorPatch": true
    },
    {
      "description": "topf and tuppr take the kubelet tag as a plain Kubernetes version, so a digest pin would break both",
      "matchDepNames": ["ghcr.io/siderolabs/kubelet"],
      "matchUpdateTypes": ["pinDigest"],
      "enabled": false
    },
    {
      "description": "talosctl and kubectl ride with staging (base), which upgrades first",
      "matchFileNames": [".mise/config.toml"],
      "matchDepNames": ["talosctl", "kubectl"],
      "additionalBranchPrefix": "base-",
      "semanticCommitScope": "base"
    },
    {
      "description": "The OVH image version provisions nodes in both environments, so it moves with production and a new node never runs ahead of it",
      "matchFileNames": ["deployment/**"],
      "matchDepNames": ["siderolabs/talos"],
      "additionalBranchPrefix": "production-",
      "semanticCommitScope": "production",
      "dependencyDashboardApproval": true
    }
  ]
}
