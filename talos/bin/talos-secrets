#!/usr/bin/env bash
# topf secrets provider (secretsProvider in talos/<env>/topf.yaml). The Talos
# secrets bundle lives in the talos/cluster Terraform state; topf calls
# `talos-secrets secrets get <clusterName>` and reads secrets.yaml from stdout.
set -euo pipefail

case "${1:-} ${2:-}" in
  "secrets get") ;;
  # topf puts only when get returns no bundle, and a generated bundle would not
  # match the running cluster. Terraform alone owns it.
  "secrets put")
    echo "talos-secrets: refusing to store a new bundle; apply deployment/modules/talos/cluster instead" >&2
    exit 1
    ;;
  *)
    echo "usage: talos-secrets secrets get|put <cluster>" >&2
    exit 2
    ;;
esac

cluster="${3:?cluster name}"
cd "$(dirname "${BASH_SOURCE[0]}")"
ENVIRONMENT="${cluster#o11y-}" exec mise run //deployment/modules/talos/cluster:output -- -raw talos_secrets
