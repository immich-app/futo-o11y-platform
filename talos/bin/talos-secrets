#!/usr/bin/env bash
# topf secrets provider (secretsProvider in talos/<env>/topf.yaml). The Talos
# secrets bundle lives in the talos/cluster Terraform state; topf calls
# `talos-secrets secrets get <clusterName>` and reads secrets.yaml from stdout.
set -euo pipefail

if [[ "${1:-}" != secrets ]]; then
  echo "usage: talos-secrets secrets get|put <cluster>" >&2
  exit 2
fi

case "${2:-}" in
  get) ;;
  # topf puts only when get finds no bundle, and a generated bundle would not
  # match the running cluster. Terraform alone owns it.
  put)
    echo "talos-secrets: refusing to store a new bundle; apply deployment/modules/talos/cluster instead" >&2
    exit 1
    ;;
  *)
    echo "usage: talos-secrets secrets get|put <cluster>" >&2
    exit 2
    ;;
esac

cluster="${3:?cluster name}"
case "$cluster" in
  o11y-staging | o11y-production) ;;
  *)
    echo "talos-secrets: unknown cluster ${cluster}" >&2
    exit 1
    ;;
esac

cd "$(dirname "${BASH_SOURCE[0]}")"
bundle="$(ENVIRONMENT="${cluster#o11y-}" mise run //deployment/modules/talos/cluster:output -- -raw talos_secrets)"
if [[ -z "$bundle" ]]; then
  echo "talos-secrets: empty talos_secrets output for ${cluster}" >&2
  exit 1
fi
printf '%s\n' "$bundle"
