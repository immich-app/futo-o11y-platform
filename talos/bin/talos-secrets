#!/usr/bin/env bash
# topf secrets provider (secretsProvider in talos/<env>/topf.yaml). The Talos
# secrets bundle (secrets.yaml) is TALOS_SECRETS in the observability project's
# <env>:/talos folder, which the cluster's own Infisical identity cannot read.
# get prints nothing when the bundle does not exist. topf then asks before it
# generates a bundle and stores it with put; never accept that for a running
# cluster, because the new CAs would not match its nodes. put only creates, so
# it fails if a bundle already exists. An Infisical error exits non-zero, so it
# never looks like a missing bundle. With only a login session, the infisical
# CLI serves its last successful fetch when Infisical is unreachable, and it
# keeps every fetch in a local backup; a token skips both, so the session's
# token is passed as INFISICAL_TOKEN.
set -euo pipefail

: "${INFISICAL_PROJECT_ID:?run topf through mise, which sets INFISICAL_PROJECT_ID}"
if [[ -z "${INFISICAL_TOKEN:-}${INFISICAL_UNIVERSAL_AUTH_ACCESS_TOKEN:-}" ]]; then
  INFISICAL_TOKEN="$(infisical user get token --plain --silent --log-level warn)"
  if [[ -z "$INFISICAL_TOKEN" ]]; then
    echo "talos-secrets: no Infisical session; run infisical login" >&2
    exit 1
  fi
  export INFISICAL_TOKEN
fi
cluster="${3:?cluster name}"
case "$cluster" in
  o11y-production) env=prod ;;
  o11y-staging) env=staging ;;
  *)
    echo "talos-secrets: unknown cluster $cluster" >&2
    exit 1
    ;;
esac
scope=(--env "$env" --path /talos --silent --log-level warn)

get() {
  infisical secrets get TALOS_SECRETS --plain --expand=false --include-imports=false --secret-overriding=false "${scope[@]}"
}

case "${1:-} ${2:-}" in
  "secrets get")
    get
    ;;
  "secrets put")
    infisical secrets-manager secrets create TALOS_SECRETS=@/dev/stdin "${scope[@]}" >/dev/null
    ;;
  *)
    echo "usage: talos-secrets secrets {get|put} <clusterName>" >&2
    exit 1
    ;;
esac
