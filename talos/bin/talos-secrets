#!/usr/bin/env bash
# topf secrets provider (secretsProvider in talos/<env>/topf.yaml). The Talos
# secrets bundle lives in the talos/cluster Terraform state; topf calls
# `talos-secrets secrets get <clusterName>` and reads secrets.yaml from stdout.
# topf puts only when get returns no bundle, and a generated bundle would not
# match the running cluster, so only get is supported.
set -euo pipefail

if [[ "${1:-} ${2:-}" != "secrets get" ]]; then
  echo "talos-secrets: only 'secrets get' is supported; apply terraform/modules/talos/cluster to create the bundle" >&2
  exit 1
fi

cluster="${3:?cluster name}"
ENVIRONMENT="${cluster#o11y-}" exec mise run //terraform/modules/talos/cluster:output -- -raw talos_secrets
